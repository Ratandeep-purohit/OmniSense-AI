# Public Phase 0 configuration. Do not add real credentials to this file.
OMNISENSE_ENVIRONMENT=development
OMNISENSE_LOG_LEVEL=INFO
OMNISENSE_CAPTURE_ENABLED=false
OMNISENSE_CAPTURE_MONITOR_ID=primary
OMNISENSE_CAPTURE_INTERVAL_MS=1000
OMNISENSE_CAPTURE_MAX_FPS=1
# Optional x,y,width,height region. Leave empty to capture the selected monitor.
OMNISENSE_CAPTURE_REGION=

# Secrets must be supplied by the local environment, never committed.
# OMNISENSE_API_KEY=
# OMNISENSE_AUTH_TOKEN=
